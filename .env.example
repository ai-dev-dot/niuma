# ============================================================
# 牛马 (Niuma) 环境变量配置
# ============================================================
# 使用步骤:
#   1. cp .env.example .env
#   2. 编辑 .env，填入你的实际值
#   3. python main.py --doctor  检查一切就绪
# ============================================================

# --- 必填 ---

# LLM API Key（必需）
# 支持任何兼容 OpenAI 接口的服务:
#   - OpenAI:     https://api.openai.com/v1
#   - 国内代理:    https://your-proxy.com/v1
#   - OpenRouter: https://openrouter.ai/api/v1
#   - 本地服务:    http://localhost:11434/v1  (Ollama 等)
LLM_API_KEY=sk-your-api-key-here

# API 接口地址（可选，默认 OpenAI）
# 如果你用代理或其他兼容服务，修改此地址
LLM_BASE_URL=https://api.openai.com/v1

# --- 模型选择 ---

# 强模型：负责编译任务 + 审核产物
# 选型原则：推理能力强，能准确分解任务和判断代码是否满足合约。
# 选你当前能用到的、推理能力最强的模型即可。
# 调用频率低（每次任务 1-2 次），token 贵一点可接受。
STRONG_MODEL=<your-strong-model>

# 弱模型：负责生成代码 + 根据报错修复
# 选型原则：会写代码但不需要太聪明，能看懂测试报错并修改即可。
# 最重要是便宜——它会大量调用（每个节点可能 5-10 轮迭代）。
# 选你当前能用到的最便宜的模型。
WEAK_MODEL=<your-weak-model>
