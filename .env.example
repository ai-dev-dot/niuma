# ============================================================
# 牛马 (Niuma) 环境变量配置
# ============================================================
# 使用步骤:
#   1. cp .env.example .env
#   2. 编辑 .env，填入你的实际值
#   3. python main.py --doctor  检查一切就绪
# ============================================================

# --- 必填 ---

# LLM API Key（必需）
# 支持任何兼容 OpenAI 接口的服务:
#   - OpenAI:     https://api.openai.com/v1
#   - 国内代理:    https://your-proxy.com/v1
#   - OpenRouter: https://openrouter.ai/api/v1
#   - 本地服务:    http://localhost:11434/v1  (Ollama 等)
LLM_API_KEY=sk-your-api-key-here

# API 接口地址（可选，默认 OpenAI）
# 如果你用代理或其他兼容服务，修改此地址
LLM_BASE_URL=https://api.openai.com/v1

# --- 模型选择 ---

# 强模型：负责编译任务和审核产物
# 需要较强的推理能力。推荐:
#   - OpenAI:    gpt-4o, gpt-4o-mini
#   - Anthropic: claude-sonnet-4-6, claude-haiku-4-5  (通过兼容接口)
#   - 国产:      deepseek-chat, qwen-max
STRONG_MODEL=gpt-4o

# 弱模型：负责生成代码+根据报错修复
# 需要能写代码但不需要太聪明。推荐:
#   - OpenAI:    gpt-4o-mini, gpt-3.5-turbo
#   - Anthropic: claude-haiku-4-5
#   - 国产:      deepseek-chat, qwen-turbo
# 越便宜越好——它会大量调用，反复试错
WEAK_MODEL=gpt-4o-mini
