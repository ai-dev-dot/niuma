{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-dev-dot/niuma/dag-schema.json",
  "title": "DAG 节点 Schema",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["node_id", "name", "signature", "contract", "test_skeleton"],
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "signature": {
            "type": "object",
            "required": ["language", "function_name"],
            "properties": {
              "language": {
                "type": "string",
                "enum": ["python", "typescript"]
              },
              "function_name": {
                "type": "string",
                "minLength": 1
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type"],
                  "properties": {
                    "name": {"type": "string"},
                    "type": {"type": "string"}
                  }
                }
              },
              "return_type": {
                "type": "string"
              },
              "allowed_imports": {
                "type": "array",
                "items": {"type": "string"}
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "return_type"],
                  "properties": {
                    "name": {"type": "string"},
                    "params": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["name", "type"],
                        "properties": {
                          "name": {"type": "string"},
                          "type": {"type": "string"}
                        }
                      }
                    },
                    "return_type": {"type": "string"}
                  }
                }
              }
            }
          },
          "contract": {
            "type": "object",
            "properties": {
              "preconditions": {
                "type": "array",
                "items": {"type": "string"}
              },
              "postconditions": {
                "type": "array",
                "items": {"type": "string"}
              },
              "invariants": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          },
          "test_skeleton": {
            "type": "string",
            "minLength": 1
          },
          "max_iterations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
