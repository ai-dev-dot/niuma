#!/usr/bin/env bash
# 牛马 Niuma — One command to rule them all
set -e
cd "$(dirname "$0")"

# 检测 Python（Ubuntu 用 python3，其他用 python）
_PY=python
command -v python3 >/dev/null 2>&1 && _PY=python3

# 首次运行自动装依赖（Python + Node.js 双方面检查）
_need_install=0
$_PY -m pytest --version >/dev/null 2>&1 || _need_install=1
[ -d "node_modules" ] || _need_install=1

if [ "$_need_install" -eq 1 ]; then
    echo "  安装依赖... | Installing dependencies..."
    _install_ok=1
    $_PY -m pip install --break-system-packages -r requirements.txt -q 2>/dev/null || _install_ok=0
    npm install --silent 2>/dev/null || true
    if [ "$_install_ok" -eq 0 ]; then
        echo "  [!!] pip 依赖安装失败 | pip install failed"
        echo "  手动执行: $_PY -m pip install --break-system-packages -r requirements.txt"
    else
        echo "  [OK] 就绪 | Ready."
    fi
    echo
fi

# 检查系统工具（首次运行时提示）
_sys_ok=1
command -v curl >/dev/null 2>&1 || { echo "  [!!] curl 未安装 — API 验证需要 | sudo apt-get install curl"; _sys_ok=0; }
command -v jq >/dev/null 2>&1 || { echo "  [!!] jq 未安装 — JSON 校验需要 | sudo apt-get install jq"; _sys_ok=0; }
command -v sqlite3 >/dev/null 2>&1 || { echo "  [!!] sqlite3 未安装 — 数据验证需要 | sudo apt-get install sqlite3"; _sys_ok=0; }
[ "$_sys_ok" -eq 0 ] && echo "  (缺少的系统工具不影响基本功能，部分验证能力受限)" && echo

$_PY cli.py "$@"
