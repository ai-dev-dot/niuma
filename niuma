#!/usr/bin/env bash
# 牛马 Niuma — One command to rule them all
set -e
cd "$(dirname "$0")"

# 首次运行自动装依赖
if [ ! -d "node_modules" ]; then
    echo "  首次运行，安装依赖... | First run, installing dependencies..."
    pip install -r requirements.txt -q 2>/dev/null || true
    npm install --silent 2>/dev/null || true
    echo "  [OK] 就绪 | Ready."
    echo
fi

python cli.py "$@"
